{
  "name": "stringju-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
    "sync:content": "node scripts/build-content.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "gen-pdf": "npm run build && node scripts/gen-pdf.mjs",
    "test": "npm run build && playwright test",
    "refresh:profile": "node scripts/refresh-profile.mjs",
    "test:format": "node --test scripts/__tests__/project-format.test.mjs",
    "test:pdf": "node --test scripts/__tests__/gen-pdf.test.mjs",
    "test:content": "playwright test --config=playwright.content.config.mjs",
    "check": "npm run build && npm run test:format && npm run test:pdf && npm run test:content"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "marked": "^18.1.2",
    "sanitize-html": "^2.18.1"
  }
}
